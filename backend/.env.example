# MongoDB
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=llm_guardrail

# LLM API Keys — Priority Rotation Order
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here
CEREBRAS_API_KEY=your_cerebras_api_key_here
NVIDIA_API_KEY=your_nvidia_api_key_here
MISTRAL_API_KEY=your_mistral_api_key_here

# JWT Auth Secret
SECRET_KEY=change_this_to_a_long_random_string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# API Rotation Config
API_ROTATION_ORDER=gemini,groq,cerebras,nvidia,mistral
RATE_LIMIT_RETRY_SECONDS=60

# CORS - comma separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,null

# Injection Detection Mode: "rules" (default, local dev) or "ml" (deployment)
# See DEPLOYMENT.md for details.
INJECTION_DETECTOR_MODE=rules
